{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "ScrapingWorker": {
    "PollingIntervalSeconds": 5
  },
  "AnalysisWorker": {
    "PollingIntervalSeconds": 5
  },
  "Scraping": {
    "Headless": true,
    "Timeout": 100000,
    "MaxRetryAttempts": 3,
    "MaxRetryDelay": 5000
  },
  "Jira": {
    "BaseUrl": "",
    "Email": "",
    "ApiToken": "",
    "ProjectKey": "",
    "JqlFilter": null,
    "MaxResultsPerPage": 50
  },
  "OpenAi": {
    "ApiKey": "",
    "EmbeddingModel": "text-embedding-3-small",
    "CompletedStatuses": [ "Done", "Closed", "Resolved" ],
    "CompletionModel": "gpt-5.4-nano",
    "ReprioritizationSimilarFeaturesTopN": 10,
    "ReprioritizationSimilarityThreshold": 0.68,
    "CoverageGapThreshold": 0.55,
    "FeatureSuggestionBatchSize": 15,
    "ReprioritizationBatchSize": 15
  },
  "Jwt": {
    "Issuer": "BacklogOptimizer",
    "Audience": "BacklogOptimizer",
    "SigningKey": "CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS",
    "AccessTokenMinutes": 60
  },
  "AdminSeed": {
    "Email": "",
    "Password": ""
  },
  "AllowedHosts": "*"
}
