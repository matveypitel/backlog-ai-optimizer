# ══════════════════════════════════════════════════════════════════════════════
#  Backlog AI Optimizer — environment variables
#  Copy this file to .env and fill in the values before running docker compose.
#
#  Usage:
#    cp .env.example .env
#    # edit .env
#    docker compose up --build
# ══════════════════════════════════════════════════════════════════════════════


# ── PostgreSQL ────────────────────────────────────────────────────────────────

POSTGRES_DB=backlog_optimizer
POSTGRES_USER=postgres
# Generate a strong password: openssl rand -base64 24
POSTGRES_PASSWORD=change_me_strong_password


# ── Jira (Atlassian Cloud) ────────────────────────────────────────────────────
# How to get an API token: https://id.atlassian.com/manage-profile/security/api-tokens

JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=PROJ

# Optional: override the default JQL query (leave empty for the built-in default)
JIRA_JQL_FILTER=

# Optional: number of issues per page (default 50, max 100)
JIRA_MAX_RESULTS_PER_PAGE=50


# ── OpenAI ────────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-proj-...

# Models (change only if you want to use different variants)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_COMPLETION_MODEL=gpt-4o-mini


# ── JWT authentication ────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate one:
#   openssl rand -hex 32

JWT_SIGNING_KEY=change_me_to_a_random_64_char_hex_string
JWT_ACCESS_TOKEN_MINUTES=60


# ── Admin seed ────────────────────────────────────────────────────────────────
# Credentials for the admin account created on first run.
# Change the password immediately after the first login.

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!


# ── Scraping ─────────────────────────────────────────────────────────────────

SCRAPING_MAX_RETRIES=3
SCRAPING_POLL_SECONDS=5
ANALYSIS_POLL_SECONDS=5


# ── Networking ────────────────────────────────────────────────────────────────
# Host port the web UI is served on (nginx).
APP_PORT=80

# API base URL baked into the frontend at build time.
#
# Leave empty (recommended for Docker):
#   nginx reverse-proxies /api/* to the API container.
#   The frontend uses same-origin requests — no CORS needed.
#
# Set to a full URL only for split deployments where the API
# is on a different host/port than the web UI:
#   PUBLIC_API_BASE_URL=https://api.myserver.com
PUBLIC_API_BASE_URL=
