# ─────────────────────────────────────────────────────────────
# Stage 1: build SvelteKit static site
# ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

# Install dependencies (cached unless package*.json changes)
COPY web/package.json web/package-lock.json* ./
RUN npm ci

# PUBLIC_API_BASE_URL is injected at BUILD time.
# Leave empty when using nginx reverse-proxy (recommended).
# Set to a full URL (e.g. https://api.myserver.com) for split deployments.
ARG PUBLIC_API_BASE_URL=
ENV PUBLIC_API_BASE_URL=${PUBLIC_API_BASE_URL}

# Build
COPY web/ .
RUN npm run build

# ─────────────────────────────────────────────────────────────
# Stage 2: serve with nginx
# ─────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS final

# Remove the default nginx site
RUN rm -rf /usr/share/nginx/html/*

# Copy built static files
COPY --from=build /app/build /usr/share/nginx/html

# Custom nginx config (SPA routing + API reverse proxy)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
